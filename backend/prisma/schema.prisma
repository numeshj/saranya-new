// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  PARENT_STUDENT
}

enum TeacherChargingModel {
  PER_STUDENT
  FIXED_MONTHLY
  FREE
}

enum AttendanceSource {
  QR_SCAN
  MANUAL
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum PaymentSource {
  QR_SCAN
  MANUAL
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)

  attendanceMarksMarked AttendanceMark[] @relation("AttendanceMarkedBy")
  paymentsCreated        Payment[]        @relation("PaymentCreatedBy")
  expensesCreated        Expense[]        @relation("ExpenseCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id        String   @id @default(uuid())
  fullName  String
  phone     String?
  isActive  Boolean  @default(true)

  qrTokens     StudentQrToken[]
  enrollments  Enrollment[]
  attendanceMarks AttendanceMark[]
  payments        Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentQrToken {
  id        String  @id @default(uuid())
  token     String  @unique
  isActive  Boolean @default(true)

  student   Student @relation(fields: [studentId], references: [id])
  studentId String

  issuedAt   DateTime @default(now())
  replacedAt DateTime?
}

model Grade {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true)

  classGroups ClassGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Teacher {
  id            String               @id @default(uuid())
  displayName   String
  phone         String?
  chargingModel TeacherChargingModel @default(FREE)
  perStudentRate     Decimal? @db.Decimal(10, 2)
  fixedMonthlyAmount Decimal? @db.Decimal(10, 2)

  classGroups ClassGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClassGroup {
  id       String  @id @default(uuid())
  name     String
  isActive Boolean @default(true)

  grade   Grade  @relation(fields: [gradeId], references: [id])
  gradeId String

  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  teacherId String?

  enrollments Enrollment[]
  attendanceSessions AttendanceSession[]
  payments           Payment[]
  monthlyFees        ClassGroupMonthlyFee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gradeId, name])
}

model ClassGroupMonthlyFee {
  id             String  @id @default(uuid())
  effectiveYear  Int
  effectiveMonth Int
  amount         Decimal @db.Decimal(10, 2)

  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])
  classGroupId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classGroupId, effectiveYear, effectiveMonth])
  @@unique([classGroupId, effectiveYear, effectiveMonth])
}

model ExpenseCategory {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true)

  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id          String   @id @default(uuid())
  expenseDate DateTime @default(now())
  amount      Decimal  @db.Decimal(10, 2)
  method      PaymentMethod @default(CASH)
  notes       String?

  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  createdByUser   User?   @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id])
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expenseDate])
  @@index([categoryId])
}

model Payment {
  id         String        @id @default(uuid())
  paidYear   Int
  paidMonth  Int
  amount     Decimal       @db.Decimal(10, 2)
  isFreeCard Boolean       @default(false)
  method     PaymentMethod @default(CASH)
  source     PaymentSource @default(QR_SCAN)
  notes      String?

  student   Student @relation(fields: [studentId], references: [id])
  studentId String

  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])
  classGroupId String

  createdByUser   User?   @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id])
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([classGroupId])
  @@index([paidYear, paidMonth])
  @@unique([studentId, classGroupId, paidYear, paidMonth])
}

model AttendanceSession {
  id           String    @id @default(uuid())
  sessionDate  DateTime
  startsAt     DateTime?
  notes        String?
  isCancelled  Boolean   @default(false)

  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])
  classGroupId String

  marks        AttendanceMark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classGroupId, sessionDate])
  @@unique([classGroupId, sessionDate])
}

model AttendanceMark {
  id        String           @id @default(uuid())
  markedAt  DateTime         @default(now())
  source    AttendanceSource @default(QR_SCAN)

  session   AttendanceSession @relation(fields: [sessionId], references: [id])
  sessionId String

  student   Student @relation(fields: [studentId], references: [id])
  studentId String

  markedByUser   User?   @relation("AttendanceMarkedBy", fields: [markedByUserId], references: [id])
  markedByUserId String?

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model Enrollment {
  id          String    @id @default(uuid())
  startDate   DateTime  @default(now())
  endDate     DateTime?
  isActive    Boolean   @default(true)

  student   Student   @relation(fields: [studentId], references: [id])
  studentId String

  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])
  classGroupId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([classGroupId])
  @@unique([studentId, classGroupId, startDate])
}
