# Copy to .env and fill in values
# MySQL connection string
# Note: Prisma migrations expect the database to exist. Use `npm run db:init` to create it without opening SQL.
DATABASE_URL="mysql://root:228646@localhost:3306/saranya"

# MySQL connection (used by db:init script)
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="228646"
MYSQL_DATABASE="saranya"

# JWT auth
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"

# Server
PORT=3000
